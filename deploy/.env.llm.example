# deploy/compose.llm.yml 용 환경변수 템플릿 (finble-server LLM 스택)
#
# 서버에서 deploy/.env.llm 으로 복사해 채운다. git 에 안 올라간다(.gitignore 의 .env*).
# 권한: chmod 600. 키 생성: python3 -c "import secrets; print(secrets.token_hex(32))"

# --- DB (infra/compose.yaml 의 neosdl-postgres — litellm/langfuse DB 를 여기에 만든다) ---
POSTGRES_HOST=neosdl-postgres
POSTGRES_USER=neosdl
# infra/.env 의 POSTGRES_PASSWORD 와 같은 값
POSTGRES_PASSWORD=

# --- LiteLLM 게이트웨이 관리자 키 / 암호화 솔트 ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# --- 로컬 모델 (이 서버 GPU, RTX 3080 12GB) — 비우면 compose 기본값 ---
# 모델 파일은 첫 기동 때 Hugging Face Hub 에서 받아 /fast/neosdl/models 에 저장된다.
# VLLM_MODEL 을 바꾸면 litellm/config.internal.yaml 의 local-qwen-coder 도 같이 바꿀 것.
VLLM_MODEL=
VLLM_IMAGE=
VLLM_GPU_UTIL=
VLLM_MAX_MODEL_LEN=
EMBED_MODEL=
EMBED_IMAGE=
# gated 모델을 받을 때만 필요
HF_TOKEN=

# --- 외부 LLM 프로바이더 키 (선택, 채운 만큼만 해당 모델이 살아난다) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# --- Langfuse (자체호스팅 트레이싱) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# UI 는 SSH 터널(-L 3000:127.0.0.1:3000)로 열기 때문에 localhost 기준.
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# --- 참고: 앱(/srv/projects/neosdl/app/.env)에 넣을 값 ---
# LITELLM_BASE_URL=http://127.0.0.1:4000
# LITELLM_API_KEY=<POST /key/generate 로 발급한 앱용 virtual key>
# LANGFUSE_HOST=http://127.0.0.1:3000
