# deploy/migrate.py --env-file 용 템플릿 — DB 마이그레이션(DDL) 전용 접속 정보.
#
# 서버 위치: /srv/projects/neosdl/secrets/migrate.env  (root:root, chmod 600)
# 앱 실행 계정(neosdl_app)은 CREATE/ALTER 권한이 없으므로, 스키마 변경은 이 계정으로만 한다.
# 이 파일은 앱 프로세스(User=neosdl)가 읽을 수 없어야 한다 — 그래서 app/.env 에 두지 않는다.

# 마이그레이션 계정(테이블 소유자/슈퍼유저). 비밀번호는 infra/.env 의 POSTGRES_PASSWORD.
MIGRATION_DATABASE_URL=postgresql://neosdl:<비밀번호>@172.20.1.10:5432/neosdl

# 적용 후 이 앱 계정이 SELECT/INSERT 를 못 하는 테이블이 있으면 경고하고 실패(exit 4)한다.
MIGRATION_APP_ROLE=neosdl_app
