# --- 정본 저장소 ---
DATABASE_URL=postgresql://neosdl:neosdl_dev@localhost:5432/neosdl

# --- 파생 조회 계층 (선택) ---
# 비워두면 GraphStore 는 postgres_cte 구현으로 폴백한다.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neosdl_dev

# --- SCM 진입점 --- GitLab/GitHub 둘 다 구현됨. provider 미지정 시 기본값.
# gitlab | github
SCM_PROVIDER=gitlab
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- GitHub OAuth 로그인 (App 설정 > "Identifying and authorizing users") ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# 세션 JWT 서명 키. 기본값 없음 — 반드시 채워야 서버가 뜬다.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# 프론트/백엔드가 nginx(운영) 또는 Vite dev 프록시(로컬)로 같은 오리진에
# 묶여 있다 — 둘 다 브라우저가 실제로 접속하는 주소(5173)를 가리킨다.
# 백엔드 프로세스 자체는 내부적으로 8000에서만 듣는다(frontend/vite.config.js
# 의 /api 프록시 대상).
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:5173

# 바로 가입할 수 있는 회사 이메일 도메인(콤마 구분, 정확히 일치). 그 외 주소는
# 그 주소로 초대를 받은 경우에만 게스트로 가입한다(app/signup_policy.py).
ALLOWED_SIGNUP_DOMAINS=aeonlab.kr,finble.io,zerokleek.com

# --- 작업 공간 ---
NEOSDL_WORKDIR=/var/tmp/neosdl
WORKER_NAME=worker-1

# --- LLM 게이트웨이 (LiteLLM Proxy) ---
# 백엔드는 이 게이트웨이의 OpenAI 호환 /v1 엔드포인트만 호출한다. 모델 목록은
# litellm/config.yaml 에서 정의되고, 프론트 드롭다운은 GET /models 로 받아온다.
LITELLM_BASE_URL=http://localhost:4000
# 앱이 게이트웨이에 인증할 키. 최초엔 아래 MASTER_KEY 를 그대로 넣어도 되고,
# 운영 기준으로는 `POST /key/generate` 로 발급한 virtual key(sk-...) 를 쓴다.
LITELLM_API_KEY=sk-neosdl-master-dev
# 모델 미지정/"auto" 요청이 떨어지는 전역 기본값 (config.yaml 의 model_name).
DEFAULT_CHAT_MODEL=local-qwen-coder

# LiteLLM 컨테이너 관리자 키 / 암호화 솔트 (docker-compose 가 주입).
LITELLM_MASTER_KEY=sk-neosdl-master-dev
LITELLM_SALT_KEY=sk-neosdl-salt-dev
# 컨테이너 → 호스트 Ollama 경로 (호스트에서 직접 돌릴 땐 무시됨).
LITELLM_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- 외부 LLM 프로바이더 키 (채운 만큼만 해당 모델이 살아난다) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# --- LLM 실행 추적(Langfuse, 자체호스팅, 개발 전용) ---
# 비워두면 app/observability.py 전체가 no-op — 앱은 추적 없이 평소대로 동작한다.
# docker-compose.dev.yml 의 langfuse 서비스가 기본값(pk-lf-neosdl-dev/sk-lf-neosdl-dev)으로
# 뜨므로, 로컬에서 켜려면 이 값들을 그대로 채우기만 하면 된다(UI: http://localhost:3000).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
