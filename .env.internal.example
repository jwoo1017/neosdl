# docker-compose.internal.yml 용 환경변수 템플릿 (finble-server 배포용)
#
# .env.example 과 달리 비밀키류는 기본값이 없다 — docker-compose.internal.yml 이
# `:?` 문법으로 강제하므로, 아래를 채우지 않으면 컨테이너가 뜨지 않는다.
# (dev 기본 키를 운영 서버에 그대로 쓰는 사고를 막기 위함)
#
# 주의: 이 파일은 git에 올라가는 "템플릿"이다 — 실제 값은 절대 여기에 채우지
# 말고 서버의 .env.internal(추적 안 됨, .gitignore의 .env* 패턴)에만 채운다.

# --- Postgres (litellm/langfuse 전용 DB만 담당, NeoSDL 정본 DB 아님) ---
POSTGRES_USER=neosdl
POSTGRES_PASSWORD=

# --- LiteLLM 게이트웨이 관리자 키 / 암호화 솔트 ---
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# --- 로컬 모델 서빙 (이 서버 자체 GPU, RTX 3080) ---
# docker-compose.internal.yml 의 vllm/embed 서비스 --model 인자 기본값과
# litellm/config.internal.yaml 의 local-qwen-coder/local-embed 는 반드시
# 같은 모델을 가리켜야 한다 — 바꾸려면 세 곳(여기, compose, litellm config)을
# 같이 바꿀 것. 비워두면 compose의 기본값(Qwen2.5-Coder-7B-Instruct-AWQ /
# mxbai-embed-large-v1)을 그대로 쓴다.
VLLM_MODEL=
EMBED_MODEL=

# --- 외부 LLM 프로바이더 키 (채운 만큼만 해당 모델이 살아난다, 선택) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# --- Langfuse (자체호스팅 트레이싱) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# UI/콜백이 스스로를 가리키는 주소 — WireGuard 내부 전용 배포이므로 finble-server의
# 고정 IP(10.0.0.5) 기준. 다른 환경이면 그 호스트:포트로 교체.
LANGFUSE_NEXTAUTH_URL=http://10.0.0.5:3000

# --- 이 스택을 바라보는 backend/frontend/worker 쪽 .env 에 설정할 값 (참고) ---
# LITELLM_BASE_URL=http://10.0.0.5:4000
# LANGFUSE_HOST=http://10.0.0.5:3000
